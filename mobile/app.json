{
  "expo": {
    "name": "KisanQueue",
    "slug": "kisanqueue",
    "version": "1.0.0",
    "scheme": "kisanqueue",
    "orientation": "portrait",
    "icon": "./assets/image.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/image.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBEF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kisanqueue.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFBEF",
        "foregroundImage": "./assets/image.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kisanqueue.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/image.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KisanQueue to access your camera to scan gate passes and QR codes."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d7261fe-d37c-430d-8dcc-1976f4312a28"
      }
    }
  }
}
