{
  "expo": {
    "name": "KisanQueue",
    "slug": "kisanqueue",
    "version": "1.0.0",
    "scheme": "kisanqueue",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B7A1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kisanqueue.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B7A1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kisanqueue.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "expo-localization"
    ]
  }
}
